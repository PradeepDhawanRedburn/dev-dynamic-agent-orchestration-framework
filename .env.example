# Copy to .env, or let `python scripts/dev_db.py up` create it with a random password.
# .env is git-ignored. Never commit real values.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# scripts/dev_db.py keeps DATABASE_URL in step with the two settings above (a postgresql:// URL for
# user "orchestrator", database "orchestrator", host 127.0.0.1). You do not need to write it yourself.

# Microsoft Foundry. Left empty on purpose: tests marked `foundry` skip (visibly) until you fill
# these in your own .env. Never put a real key in this file.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Must be v1 or preview: dated versions are rejected on the /openai/v1 path (spike S-12)
AZURE_OPENAI_API_VERSION=v1
AZURE_MODEL_EASY_TASK=gpt-5-mini
AZURE_MODEL_MID_TASK=gpt-6-luna
AZURE_MODEL_HARD_TASK=gpt-6.1-terra
